<Window x:Class="StudentSystem.SystemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentSystem"
        mc:Ignorable="d"
        Title="SystemWindow" Height="686" Width="1093" WindowStyle="None" 
        Background="Transparent" 
        MouseDown="Window_MouseDown" ResizeMode="CanResizeWithGrip"  AllowsTransparency="True" WindowStartupLocation="CenterScreen" 
        >

    <Border  Background="#F7F8F9"  CornerRadius="8 8 8 8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition  Height="30"/>
                <RowDefinition Height="50"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="187"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Image HorizontalAlignment="Center" Width="50" Source="/peeing-man-icon-1615c4.png" Height="50" VerticalAlignment="Center" Grid.Row="1"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal">

                <StackPanel x:Name="MenuButton" Margin="20,0,0,10" Width="156" >
                    <RadioButton
                        GroupName="Btn"
                        Content="Главная" 
                        Style="{StaticResource MenuButton}"
                        Height="35"
                        Click="btnMenu1_Click"
                        IsChecked="True" FontFamily="SF Pro Display" 
                        />
                    <RadioButton 
                        GroupName="Btn"
                        Content="Группы" 
                        Style="{StaticResource MenuButton}" 
                        Height="35"
                        Click="btnMenu2_Click" FontFamily="SF Pro Display" 
                        />
                    <RadioButton 
                        GroupName="Btn"
                        Content="Пользователи" 
                        Style="{StaticResource MenuButton}" 
                        Height="35"
                        Click="btnMenu3_Click" FontFamily="SF Pro Display" 
                        />
                    <RadioButton 
                        GroupName="Btn"
                        Content="Настройки" 
                        Style="{StaticResource MenuButton}" 
                        Height="35"
                        Click="btnMenu4_Click" FontFamily="SF Pro Display" 
                        />
                </StackPanel>
                <Rectangle Margin="46 0 0 0" Fill="#28091E42"  Width="2" Grid.Row="2"/>
            </StackPanel>

            <Grid Grid.Column="1" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="529*"/>
                    <ColumnDefinition Width="84*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" >

                </StackPanel>
            </Grid>
            <Frame Grid.Column="1" Grid.Row="2"
                   Name="fContainer"
                   NavigationUIVisibility="Hidden"
                   Margin="10,0,20,42"
            />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource SystemButtonMinimize}" x:Name="btnMinimize" Click="btnMinimize_Click" Padding="5"  Margin="0,0,23,0" Width="30" >
                </Button>
                <ToggleButton Style="{DynamicResource SystemToggleButton}" x:Name="btnSize" Padding="5" Click="btnSize_Click"  Margin="0,0,23,0"  Width="30">
                </ToggleButton>
                <Button Style="{DynamicResource SystemButtonClose}" Padding="5" Click="btnExit_Click"  Margin="0,0,23,0" Width="30">
                </Button>
            </StackPanel>


        </Grid>
    </Border>
</Window>
