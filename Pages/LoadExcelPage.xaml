<Page x:Class="StudInfo.Pages.LoadExcelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StudInfo.Pages"
      xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoadExcelPage">

    
    <Grid >
        <Border MouseDown="ExcelLoadElement_MouseDown" x:Name="ExcelLoadElement" Margin="10" Background="#F7F8F9" BorderThickness="4,4,4,4" CornerRadius="10,10,10,10">
            <Border.BorderBrush>
                <DrawingBrush Viewport="0,0,20,20" ViewportUnits="Absolute" TileMode="Tile">
                    <DrawingBrush.Drawing>

                        <DrawingGroup>
                            <GeometryDrawing Brush="#44546F">
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="0,0,50,50" />
                                        <RectangleGeometry Rect="50,50,50,50" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.BorderBrush>
            <Grid>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="128*"/>
                        <ColumnDefinition Width="115*"/>
                        <ColumnDefinition Width="128*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel  Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" >
                        <Image Width="180" Height="180" Source="/Resources/Images/_UploadIcon_.png" />
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" Width="100" Height="59" Foreground="#42526E" Text="Кликните, чтобы загрузить .xlsx файл" />
                    </StackPanel>

                </Grid>

            </Grid>
        </Border>
        <StackPanel  x:Name="LoadData" Visibility="Hidden" Margin="0 45 0 0">
            <ComboBox Style="{DynamicResource ComboBoxStyle}" x:Name="comboboxGroups"  Width="150" Height="26"  Background="#00000000" HorizontalAlignment="Left" Margin="0 0 0 18">
            </ComboBox>
            
            <DataGrid Height="430" x:Name="dgvLoad"  RowDetailsTemplate="{DynamicResource DataGridRowDetailsTemplate1}"  CellStyle="{DynamicResource DataGridCellStyle1}" 
                  RowStyle="{DynamicResource DataRowStudent}"
                  AutoGenerateColumns="True"
                  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                  GridLinesVisibility="None" IsReadOnly="True" Background="{x:Null}" 
                  FontFamily="SF Pro Display" FontSize="16" Foreground="#FF44546F" 
                  SelectionMode="Single"  BorderBrush="#00688CAF" Margin="0 2 0 13">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="FontWeight" Value="SemiBold"/>

                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
            <Button Style="{DynamicResource CostomBtn}" Width="150" Height="26" HorizontalAlignment="Right" x:Name="btn_LoadtoDb" Click="btn_LoadtoDb_Click" Content="Загрузить в базу"></Button>
        </StackPanel>

    </Grid>


</Page>
