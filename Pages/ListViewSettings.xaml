<Page x:Class="StudInfo.Pages.ListViewSettings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StudInfo.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListViewSettings"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="75"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1" Margin="0 20 0 0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel Orientation="Vertical" >
                <Label Content="Изменение API группы ВКонтакте" FontFamily="SF Pro Display" FontSize="11" Padding="4 5 0 2" FontWeight="Bold" Margin="5 0 0 3" Foreground="#44546F"/>
                <TextBox  Style="{DynamicResource APITextBox}"  Margin="0 0 5 0" x:Name="VKAPITextBox" />
            </StackPanel>
            <Grid VerticalAlignment="Bottom">
                <Button Style="{DynamicResource CostomBtn}" Height="32" Width="100" Content="Сохранить" x:Name="SaveAPIBtn" Click="SaveAPIBtn_Click" />
                <Button Style="{DynamicResource GrayCostomBtn}" Height="32" Width="100"  Content="Изменить" x:Name="ChangeAPIBtn" Click="ChangeAPIBtn_Click" />
            </Grid>
        </StackPanel>
    </Grid>
</Page>
