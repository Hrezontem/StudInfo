<Window x:Class="StudInfo.MsgBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudInfo"
        Title="Сообщение" 
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="None" Background="Transparent" Height="500" Width="500"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Стили для разных типов сообщений -->
        <Style x:Key="ErrorStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>

        </Style>
        <Style x:Key="WarningStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
        </Style>
        <Style x:Key="InfoStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
        </Style>
        <Style x:Key="SuccessStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" Padding="10" CornerRadius="5" Height="185" Width="400"  Background="White">


        <StackPanel>
            <!-- Заголовок и иконка -->
            <DockPanel Margin="12,12,0,15">
                <Viewbox DockPanel.Dock="Left" 
                         Width="32" Height="32" 
                         Margin="0,0,15,0">
                    <Path x:Name="IconPath" Stretch="Uniform"
                          Data="{StaticResource ErrorIcon}"
                          Fill="#FF4444"/>
                </Viewbox>
                <TextBlock x:Name="TitleText" 
                           Text="Title" 
                           VerticalAlignment="Center"
                           FontSize="23"
                           FontWeight="Bold"
                           FontFamily="SF Pro Display"
                           Foreground="#44546F"/>
            </DockPanel>

            <!-- Сообщение -->
            <TextBlock x:Name="MessageText" 
                     TextWrapping="Wrap"
                     Margin="15,0,0,20"
                     FontFamily="SF Pro Display"
                     Foreground="#44546F"
                     FontSize="13"/>

            <!-- Кнопки -->
            <StackPanel x:Name="ButtonsPanel"
          Orientation="Horizontal" 
          HorizontalAlignment="Right" Margin="0 10 0 0"
                        VerticalAlignment="Bottom">
                <Button Click="OkButton_Click" x:Name="OkButton" Content="Подтвердить" Style="{DynamicResource CostomBtn}"
          Width="120" Height="30" Margin="2 0 15 0"
          />
                <Button Click="CancelButton_Click" x:Name="CancelButton" Content="Cancel" Style="{DynamicResource GrayCostomBtn}" 
          Width="55" Height="20"
          Visibility="Collapsed"
          />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
