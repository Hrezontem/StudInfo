<Window x:Class="StudInfo.MsgBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudInfo"
        Title="Сообщение" 
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStyle="None">
    <Window.Resources>
        <!-- Стили для разных типов сообщений -->
        <Style x:Key="ErrorStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF5F5"/>
            <Setter Property="BorderBrush" Value="#FFEBEBEB"/>

        </Style>
        <Style x:Key="WarningStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFEF7E5"/>
            <Setter Property="BorderBrush" Value="#FFF8E6C5"/>
        </Style>
        <Style x:Key="InfoStyle" TargetType="Border">
            <Setter Property="Background" Value="#F0F8FF"/>
            <Setter Property="BorderBrush" Value="#B0C4DE"/>
        </Style>
        <Style x:Key="SuccessStyle" TargetType="Border">
            <Setter Property="Background" Value="#F0FFF0"/>
            <Setter Property="BorderBrush" Value="#98FB98"/>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" Padding="20" CornerRadius="5"
            BorderThickness="2" >
        <StackPanel>
            <!-- Заголовок и иконка -->
            <DockPanel Margin="0,0,0,15">
                <Viewbox DockPanel.Dock="Left" 
                         Width="32" Height="32" 
                         Margin="0,0,15,0">
                    <Path x:Name="IconPath" Stretch="Uniform"
                          Data="{StaticResource ErrorIcon}"
                          Fill="#FF4444"/>
                </Viewbox>
                <TextBlock x:Name="TitleText" 
                           Text="Title" 
                           FontSize="18"
                           FontWeight="Bold"/>
            </DockPanel>

            <!-- Сообщение -->
            <TextBlock x:Name="MessageText" 
                     TextWrapping="Wrap"
                     Margin="0,0,0,20"/>

            <!-- Кнопки -->
            <StackPanel x:Name="ButtonsPanel" 
                      Orientation="Horizontal" 
                      HorizontalAlignment="Right">
                <Button Click="OkButton_Click" x:Name="OkButton" Content="OK" Style="{DynamicResource CostomBtn}"
                      Width="80" Margin="5,0"
                      />
                <Button Click="CancelButton_Click" x:Name="CancelButton" Content="Cancel" Style="{DynamicResource GrayCostomBtn}" 
                      Width="80" Margin="5,0"
                      Visibility="Collapsed"
                      />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
