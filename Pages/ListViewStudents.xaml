<Page x:Class="StudentSystem.Pages.ListViewStudents"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StudentSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListViewStudents"
      Loaded="Page_Loaded">
    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Page.Resources>
    <Grid>
        <ListBox x:Name="ListBoxStudent" ItemsSource="{Binding Students}" Background="#F7F8F9" BorderBrush="#00ABADB3" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">

            <ListBox.ItemTemplate >
                <DataTemplate>
                    <Border  CornerRadius="8 8 8 8" Padding="2" UseLayoutRounding="True">
                        <StackPanel Orientation="Horizontal" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                            <TextBlock  FontSize="18" Text="{Binding Path=Name}" FontFamily="SF Pro Display" Foreground="#44546F" Padding="4 0 0 0" />
                            <TextBlock  FontSize="16" Text="{Binding Path=Card}" FontFamily="SF Pro Display" Foreground="#44546F" Padding="4 0 0 0" />
                            <TextBlock  FontSize="16" Text="{Binding Path=Group}" FontFamily="SF Pro Display" Foreground="#44546F" Padding="4 0 0 0" />
                        </StackPanel>
                    </Border>

                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>



</Page>
