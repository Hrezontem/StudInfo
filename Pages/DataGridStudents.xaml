<Page x:Class="StudentSystem.Pages.DataGridStudents"
      
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StudentSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DataGridStudents"
      Loaded="dgvStudents_Loaded"
      xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2">

    <StackPanel Orientation="Vertical">
        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0 43 0 10">
            <TextBox Style="{DynamicResource SearchTextBox}" Margin="0 0 0 0" Width="284" Height="32" FontSize="15" VerticalAlignment="Center" x:Name="searchTextBox" TextChanged="searchTextBox_TextChanged" BorderThickness="1" />
            <ComboBox Style="{DynamicResource ComboBoxStyle}" Margin="20 0 0 0" Width="150" Height="32" x:Name="FilterComboBox" Background="#00000000">
                <ComboBoxItem>Option 1</ComboBoxItem>
                <ComboBoxItem>Option 2</ComboBoxItem>
            </ComboBox>
        </StackPanel>
        <DataGrid RowDetailsTemplate="{DynamicResource DataGridRowDetailsTemplate1}"  CellStyle="{DynamicResource DataGridCellStyle1}" 
                  RowStyle="{DynamicResource DataRowStudent}"  x:Name="dgvStudents" 
                  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" 
                  GridLinesVisibility="None" IsReadOnly="True" Background="{x:Null}" 
                  FontFamily="SF Pro Display" FontSize="16" Foreground="#FF44546F" 
                  SelectionMode="Single"  BorderBrush="#00688CAF" Grid.RowSpan="2"
                  DataGridCell.Selected="dgvStudents_Selected" MouseDoubleClick="dgvStudents_MouseDoubleClick"
                  Margin="0 13 0 0">
            <DataGrid.Columns>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu Background="White" BorderThickness="2" BorderBrush="LightGray" >
                    <Label Content="Просмотр" x:Name="InformationLabel" MouseDown="InformationLabel_MouseDown"/>
                    <Label Content="Изменить" x:Name="UpdateLabel" MouseDown="UpdateLabel_MouseDown"/>
                    <Label Content="Отчислить" x:Name="DismissStudentLabel" MouseDown="DismissStudentLabel_MouseDown"/>
                    <Label Content="Удалить" x:Name="DeleteStudentLabel" MouseDown="DeleteStudentLabel_MouseDown"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FontWeight" Value="SemiBold"/>

                </Style>
            </DataGrid.ColumnHeaderStyle>
        </DataGrid>
    </StackPanel>
</Page>
