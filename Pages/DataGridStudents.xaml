<Page x:Class="StudentSystem.Pages.DataGridStudents"
      
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StudentSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DataGridStudents"
      Loaded="dgvStudents_Loaded">

    <Grid>
        <DataGrid RowDetailsTemplate="{DynamicResource DataGridRowDetailsTemplate1}"  CellStyle="{DynamicResource DataGridCellStyle1}" RowStyle="{DynamicResource DataRowStudent}"  x:Name="dgvStudents" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" GridLinesVisibility="None" IsReadOnly="True" Background="{x:Null}" FontFamily="SF Pro Display" FontSize="16" Foreground="#FF44546F" SelectionMode="Single"  BorderBrush="#00688CAF" Grid.RowSpan="2">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
        </DataGrid>
    </Grid>
</Page>
