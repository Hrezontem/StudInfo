<Page x:Class="StudentSystem.Pages.ListViewSpec"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:StudentSystem.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListViewSpec">
    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="85"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical" Grid.Row="0">
            <Grid >
                <StackPanel  Orientation="Horizontal" VerticalAlignment="Top" Margin="0 43 0 0" >
                    <TextBox Style="{DynamicResource SearchTextBox}" Margin="0 0 0 0" Width="284" Height="32" FontSize="15" VerticalAlignment="Center" x:Name="searchTextBox" TextChanged="searchTextBox_TextChanged" BorderThickness="1" />
                </StackPanel>
            </Grid>
            <Rectangle HorizontalAlignment="Center" Margin="0 7 0 10" Fill="#28091E42" Panel.ZIndex="1000" Width="100000" Height="2"/>
        </StackPanel>
        <ListBox x:Name="ListBoxSpec" Grid.Row="1" ItemsSource="{Binding Spec}" BorderBrush="Transparent" Background="Transparent"  Margin="0 5 0 4">
            <ListBox.ContextMenu>
                <ContextMenu Background="White" BorderThickness="2" BorderBrush="LightGray">
                    <MenuItem Header="Просмотр" x:Name="ViewBtn" Click="ViewBtn_Click"/>
                    <MenuItem Header="Изменить" x:Name="UpdateBtn" Click="UpdateBtn_Click"/>
                    <MenuItem Header="Удалить" x:Name="DeleteBtn" Click="DeleteBtn_Click"/>
                    
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel   Margin="5"  x:Name="SpecInfoBtn" MouseDown="SpecInfoBtn_MouseDown">
                        <TextBlock x:Name="SpecCodeTBlock" FontSize="18" Text="{Binding Path=SpecCode}" FontFamily="SF Pro Display" Foreground="#44546F"/>
                        <TextBlock x:Name="FullTitleTBlock" FontSize="14" Text="{Binding Path=FullTitle}" FontFamily="SF Pro Display" Foreground="#44546F" />
                        <TextBlock x:Name="TitleTBlock" Text="{Binding Path=Title}" FontFamily="SF Pro Display" Foreground="#44546F" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Rectangle HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Bottom" Margin="0 0 0 1" Fill="#28091E42" Panel.ZIndex="1000" Width="100000" Height="2"/>
    </Grid>

</Page>
